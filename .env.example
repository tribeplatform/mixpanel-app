# PORT
PORT = 80

# DATABASE
DB_HOST = ""

# TOKEN
GRAPHQL_URL="https://app.tribe.so/graphql"
CLIENT_ID = ""
CLIENT_SECRET = ""
SIGNING_SECRET = ""
NETWORK_ID = ""
MEMBER_ID = ""

# Max JSON body size for webhooks (body-parser syntax, e.g. 2mb). Defaults to 2mb.
BODY_SIZE_LIMIT = 2mb

# LOG
LOG_FORMAT = dev
LOG_DIR = ../logs

# CORS
ORIGIN = *
CREDENTIALS = true
